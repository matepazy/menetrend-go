<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/widget_row_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:padding="16dp" android:background="@drawable/stop_widget_departure_card">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/widget_logo" android:layout_width="wrap_content" android:maxWidth="56dp" android:adjustViewBounds="true" android:layout_height="20dp" android:scaleType="fitStart" android:importantForAccessibility="no" android:layout_marginEnd="4dp" />
                <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/widget_badge_fill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignStart="@id/widget_service" android:layout_alignEnd="@id/widget_service"
                        android:layout_alignTop="@id/widget_service" android:layout_alignBottom="@id/widget_service"
                        android:src="@drawable/widget_service_badge_fill" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
                    <TextView android:id="@+id/widget_service" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                </RelativeLayout>
                <ImageView android:id="@+id/widget_inline_direction" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_service_direction" android:contentDescription="Irány" android:visibility="gone" />
                <TextView android:id="@+id/widget_inline_destination" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_direction_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_direction" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="3dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_service_direction" android:contentDescription="Irány" />
                <TextView android:id="@+id/widget_destination" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
            </LinearLayout>
            <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/widget_muted" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
            <TextView android:id="@+id/widget_departure_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textStyle="normal" android:textColor="@color/widget_muted" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_card_gap" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="12dp" />
</LinearLayout>
